{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tags": ["layer-app"],
  "tasks": {
    "prisma:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/prisma/**"]
    },
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "prisma:generate"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "prisma:generate"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "prisma:generate"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "prisma:generate"]
    },
    "test:e2e": {
      "dependsOn": ["$TURBO_EXTENDS$", "prisma:generate"]
    },
    "dev": {
      "dependsOn": ["$TURBO_EXTENDS$", "^build", "prisma:generate"]
    }
  }
}
